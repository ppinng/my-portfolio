{
  "version": 2,
  "builds": [
    {
      "src": "api/*.go",
      "use": "@vercel/go"
    },
    {
      "src": "dist/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/[^.]+", "dest": "/", "status": 200 },
    {
      "src": "/api/(.*)",
      "dest": "/api/main.go"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
